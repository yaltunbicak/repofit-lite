# ============================================================
# RepoFit Lite — Environment Configuration
# ============================================================
# Copy this file as .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------
# Options: gemini | anthropic | openai
LLM_PROVIDER=gemini
# Model name — must match the selected provider
# Gemini:    gemini-2.5-flash (cheap, fast) | gemini-2.5-pro (powerful)
# Anthropic: claude-sonnet-4-20250514 | claude-haiku-4-5-20251001
# OpenAI:    gpt-4o-mini (cheap) | gpt-4o (powerful)
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=8192

# ------------------------------------------------------------
# LLM API Keys — only the selected provider's key is required
# ------------------------------------------------------------
GEMINI_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# ------------------------------------------------------------
# GitHub (required)
# ------------------------------------------------------------
GITHUB_TOKEN=
# Optional: multiple tokens for higher rate limits (comma-separated)
#GITHUB_TOKENS=ghp_token1,ghp_token2,ghp_token3

# ------------------------------------------------------------
# GitLab (optional)
# ------------------------------------------------------------
#GITLAB_TOKEN=
#GITLAB_URL=https://gitlab.com

# ------------------------------------------------------------
# ecosyste.ms (optional — email for polite pool)
# ------------------------------------------------------------
#ECOSYSTEMS_EMAIL=

# ------------------------------------------------------------
# Cache
# ------------------------------------------------------------
CACHE_DIR=./cache
CACHE_TTL_HOURS=24
